<?xml version="1.0" encoding="UTF-8" ?>
<Application xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:TaTySho"
             x:Class="TaTySho.App">
    <Application.Resources>
        <ResourceDictionary>

            <LinearGradientBrush x:Key="SpaceBackground" StartPoint="0,0" EndPoint="1,1">
                <GradientStop Color="#0F2027" Offset="0.0" />
                <GradientStop Color="#203A43" Offset="0.5" />
                <GradientStop Color="#2C5364" Offset="1.0" />
            </LinearGradientBrush>

            <Style TargetType="ContentPage">
                <Setter Property="Background" Value="{StaticResource SpaceBackground}" />
                <Setter Property="NavigationPage.HasNavigationBar" Value="False" />
                <Setter Property="Shell.NavBarIsVisible" Value="False" />
            </Style>

            <Style TargetType="Button">
                <Setter Property="CornerRadius" Value="25"/>
                <Setter Property="FontAttributes" Value="Bold"/>
                <Setter Property="TextColor" Value="#0F2027"/>
                <Setter Property="BackgroundColor" Value="White"/>
                <Setter Property="HeightRequest" Value="55"/>
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>