<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="TaTySho.StartPage"
             Shell.NavBarIsVisible="False"
             NavigationPage.HasNavigationBar="False">

    <ContentPage.Background>
        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#0F2027" Offset="0.0" />
            <GradientStop Color="#203A43" Offset="0.5" />
            <GradientStop Color="#2C5364" Offset="1.0" />
        </LinearGradientBrush>
    </ContentPage.Background>

    <Grid>
        <AbsoluteLayout InputTransparent="True" HorizontalOptions="Fill" VerticalOptions="Fill">
            <BoxView x:Name="Firefly1" Color="#00E5FF" CornerRadius="50" Opacity="0.6" WidthRequest="15" HeightRequest="15"
                     AbsoluteLayout.LayoutBounds="0.2, 0.3, 15, 15" AbsoluteLayout.LayoutFlags="PositionProportional" />

            <BoxView x:Name="Firefly2" Color="#FF00CC" CornerRadius="50" Opacity="0.5" WidthRequest="25" HeightRequest="25"
                     AbsoluteLayout.LayoutBounds="0.8, 0.7, 25, 25" AbsoluteLayout.LayoutFlags="PositionProportional" />

            <BoxView x:Name="Firefly3" Color="#FFFF00" CornerRadius="50" Opacity="0.4" WidthRequest="10" HeightRequest="10"
                     AbsoluteLayout.LayoutBounds="0.5, 0.5, 10, 10" AbsoluteLayout.LayoutFlags="PositionProportional" />
        </AbsoluteLayout>

        <Grid VerticalOptions="Center" HorizontalOptions="Center" Padding="30" ZIndex="99">

            <Frame CornerRadius="40" 
                   BackgroundColor="#20FFFFFF" 
                   BorderColor="#50FFFFFF" 
                   HasShadow="False"
                   Padding="30,50">

                <VerticalStackLayout Spacing="30" VerticalOptions="Center">

                    <VerticalStackLayout Spacing="-5">
                        <Label Text="ТаТиШо!" FontSize="50" FontAttributes="Bold" TextColor="White" HorizontalOptions="Center">
                            <Label.Shadow>
                                <Shadow Brush="#00E5FF" Offset="0,0" Radius="15" Opacity="0.8"/>
                            </Label.Shadow>
                        </Label>
                        <Label Text="PARTY GAME" TextColor="#00E5FF" FontSize="14" FontAttributes="Bold" CharacterSpacing="8" HorizontalOptions="Center" Opacity="0.9"/>
                    </VerticalStackLayout>

                    <BoxView HeightRequest="1" Color="#50FFFFFF" WidthRequest="100" HorizontalOptions="Center" Margin="0,10"/>

                    <Button x:Name="PlayBtn"
                            Text="ГРАТИ" 
                            Clicked="OnPlayClicked"
                            BackgroundColor="White" 
                            TextColor="#0F2027" 
                            FontAttributes="Bold"
                            FontSize="22"
                            CornerRadius="25"
                            HeightRequest="65"
                            WidthRequest="220"
                            ZIndex="100">
                        <Button.Shadow>
                            <Shadow Brush="Black" Offset="0,5" Radius="10" Opacity="0.3"/>
                        </Button.Shadow>
                    </Button>

                    <Button Text="Налаштування" Clicked="OnSettingsClicked" BackgroundColor="#15FFFFFF" TextColor="White" FontSize="16" CornerRadius="20" HeightRequest="50" WidthRequest="220" BorderColor="#50FFFFFF" BorderWidth="1"/>
                </VerticalStackLayout>
            </Frame>
        </Grid>

        <Border VerticalOptions="Start" HorizontalOptions="End" Margin="20" StrokeShape="RoundRectangle 20" Stroke="Transparent" BackgroundColor="#20FFFFFF" Padding="10" HeightRequest="50" WidthRequest="50">
            <Border.GestureRecognizers>
                <TapGestureRecognizer Tapped="OnThemeTapped"/>
            </Border.GestureRecognizers>
            <Label x:Name="ThemeIconLabel" Text="🌙" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center"/>
        </Border>

    </Grid>
</ContentPage>